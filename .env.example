# LLM provider: openrouter | runpod
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=perplexity/sonar-pro
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=MailCraft
OPENROUTER_WEB_PLUGIN=true

# RunPod (optional fallback)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID/openai/v1
RUNPOD_MODEL=your-model-name

# Generation settings
GENERATION_CONCURRENCY=3
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# App
DATABASE_URL=sqlite+aiosqlite:///./data/mailing.db
CORS_ORIGINS=http://localhost:5173
# Must be public HTTPS for open/click tracking. Localhost links go to spam in Gmail.
PUBLIC_BASE_URL=http://127.0.0.1:8000
TRACKING_HMAC_SECRET=change-me
SEND_THROTTLE_SECONDS=45

# Yandex OAuth (Mail SMTP + Metrika read)
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_REDIRECT_URI=https://oauth.yandex.ru/verification_code
YANDEX_OAUTH_SCOPES=mail:smtp mail:imap_ro metrika:read
YANDEX_MAIL_FROM=
